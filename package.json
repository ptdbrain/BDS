{
  "name": "ahs-bds-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && node prisma/seed.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:role-booking && node --experimental-strip-types --test scripts/tests/contract-financial-policy.test.mjs scripts/tests/booking-approval.test.mjs scripts/tests/ui-layout.test.mjs",
    "test:role-booking": "node --experimental-strip-types --test scripts/tests/role-booking-status.test.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.11",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.454.0",
    "next": "^14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
